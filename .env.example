# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/ovianta?retryWrites=true&w=majority

# Application base URL (used for redirects and email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OTP email provider — choose one:
# Option A: Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option B: SendGrid
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address for OTP emails
EMAIL_FROM=noreply@ovianta.com

# Auth secret — used to sign session tokens (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-random-secret-at-least-32-chars

# Demo OTP code (remove in production — real flow sends codes via email)
NEXT_PUBLIC_DEMO_OTP=482019
